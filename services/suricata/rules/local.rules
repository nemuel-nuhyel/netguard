alert http any any -> any any (msg:"NETGUARD safe traffic generator user agent"; flow:to_server,established; http.user_agent; content:"NetGuardTrafficGenerator"; classtype:web-application-activity; sid:1000001; rev:1;)
alert http any any -> any any (msg:"NETGUARD lab admin path probe"; flow:to_server,established; http.uri; content:"/admin"; startswith; classtype:web-application-activity; priority:2; sid:1000002; rev:1;)
alert dns any any -> any any (msg:"NETGUARD DNS request for example.com"; dns.query; content:"example.com"; nocase; classtype:misc-activity; sid:1000003; rev:1;)
alert tcp any any -> any 8080 (msg:"NETGUARD unexpected TCP probe to 8080"; flags:S; flow:stateless; classtype:attempted-recon; sid:1000004; rev:1;)
