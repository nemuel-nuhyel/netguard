# ── Secrets: targeted names/paths only, never broad config wildcards ──
.env
.env.*
!.env.example
.envrc
.direnv/
*.key
*.pem
*.p12
*.pfx
*.jks
*.keystore
*_privatekey
*privatekey*
wg0.conf
# linuxserver/wireguard generated peer dirs
peer*/
# runtime WG config (keys) written into the volume
docker/wireguard/config/**
# future per-service WG config
services/wireguard/config/**

# ── docs/: build scratch is ignored; the demo the README embeds is not ──
# Use `docs/*` (not `docs/`) so the negations below can take effect — git does
# not descend into an ignored directory, so a trailing-slash ignore would make
# the README's demo embed a broken link.
docs/*
!docs/demo.gif
!docs/demo.mp4
!docs/demo.tape
!docs/VHS.Dockerfile
!docs/.dockerignore

# ── Runtime data (regenerated by `docker compose up`) ──
loki-data/
prometheus-data/
grafana-data/
suricata-logs/
logs/*.log
*.log
*.pid
*.tmp
*.sqlite
*.sqlite3
data/
# attack-sim run artifacts: manifests, copied eve.json, scorecards
runs/
# Python bytecode
__pycache__/
*.pyc

# Python tooling / packaging (all regenerated locally)
.coverage
.coverage.*
coverage.xml
htmlcov/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.nox/
.venv/
venv/
build/
dist/
*.egg-info/

# ── Editor / OS ──
.DS_Store
Thumbs.db
Desktop.ini
.vscode/
.idea/
*.swp
*.swo

# NOTE: intentionally NOT ignored (a CI check asserts these stay tracked):
#   docker-compose.yml, **/*.yml under monitoring/, services/**/*.yaml,
#   services/**/*.py, scripts/*.sh, architecture/**, docs/**

# scratch: lock files I moved aside — delete this folder, do not commit
_to_delete/
